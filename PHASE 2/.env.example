# ========================================================
# Short Interest Trend Prediction: Production Environment Template
# ========================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
# Comma-separated list of allowed origins for CORS (e.g., https://your-app.vercel.app)
CORS_ORIGINS=*

# Persistent Storage & Model Directories
# If using a persistent volume (e.g. on Render or Railway), mount here:
DATABASE_PATH=data/processed/notifications.db
MODEL_DIR=models/artifacts

# SEC EDGAR API Configuration (Requires valid institutional/contact email)
SEC_USER_AGENT=ShortInterestResearchPlatform admin@domain.com

# Gemini LLM Event Classifier Configuration
GEMINI_API_KEY=your_actual_gemini_api_key
USE_GEMINI_CLASSIFIER=true
GEMINI_MODEL=gemini-3.5-flash-lite

# FINRA API Credentials (Optional, for consolidated live short interest)
FINRA_CLIENT_ID=
FINRA_CLIENT_SECRET=
